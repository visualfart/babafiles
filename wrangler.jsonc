{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "babafiles",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "babafiles", "database_id": "07319907-fc0d-40ad-ba4e-1dd308dd0f5a" }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
